import type { BrainObject, BrainCollection } from './api';
import type { VaultTree } from './vaultTreeModel.mjs';
export type CabinetFolder = { id: string; name: string; color: string; sourceIds: string[]; system: boolean; collectionId: string | null };
export type CabinetGroupId = 'notes' | 'documents' | 'memory';
export const CABINET_PALETTE: readonly { name: string; color: string }[];
export const CABINET_GROUPS: readonly { id: CabinetGroupId; name: string }[];
export const ALL_FILES: string;
export const UNFILED_FILES: string;
export function validFolderColor(value: unknown): value is string;
export function colorContrast(a: string, b: string): number;
export function folderMaterial(value: unknown): Record<'--fc-fill' | '--fc-ink' | '--fc-muted' | '--fc-line' | '--fc-grid', string>;
export function defaultFolderColor(id: string): string;
export function sourceGroup(object: BrainObject): CabinetGroupId;
export function cabinetFolders(objects: BrainObject[], collections?: BrainCollection[], member?: boolean): CabinetFolder[];
export function cabinetFiles(objects: BrainObject[], folder: CabinetFolder, query?: string, group?: string): BrainObject[];
export function cabinetGroups(objects: BrainObject[]): { id: CabinetGroupId; name: string; count: number }[];
export function cabinetPage(folders: CabinetFolder[], selectedId: string, size?: number): { folders: CabinetFolder[]; start: number; end: number; previousId: string | null; nextId: string | null };
export function reconcileCabinetSelection(selectedId: string | null, previousId: string | null, allFiles: BrainObject[], visible: BrainObject[], limit?: number): { selectedId: string | null; resetView: boolean; limit: number };
export function collectionPatch(collection: BrainCollection, changes?: { addId?: string; removeId?: string; color?: string }): { id: string; sourceIds?: string[]; color?: string };
export type CabinetVault = { tree: VaultTree; rootIds: string[]; rootNames: Map<string, string>; allowedRoots: Set<string>; folderCount: number; fileCount: number };
export type CabinetVaultFolder = CabinetFolder & { vaultId: string; rootId: string; parentId: string | null; path: string; rootPath: string; rootName: string; directCount: number; totalCount: number };
export function buildCabinetVault(objects: BrainObject[], folders?: { id: string; path: string }[], member?: boolean): CabinetVault;
export function cabinetVaultFolder(model: CabinetVault, id: string, subtree?: boolean): CabinetVaultFolder | null;
export function cabinetVaultChildren(model: CabinetVault, id: string): { id: string; name: string; path: string; count: number; directCount: number }[];
export function cabinetVaultBreadcrumbs(model: CabinetVault, id: string): { id: string; name: string; path: string }[];
export function cabinetVaultContainingFolder(model: CabinetVault, sourceId: string): string | null;
export function cabinetReadableObjects(objects: BrainObject[], member?: boolean): BrainObject[];
