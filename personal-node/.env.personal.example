# Copy to repository-root .env.personal; keep permissions 0600 and out of Git.
# Generate two DISTINCT random credentials of at least 32 characters.
ARKIVE_TOKEN=
ARKIVE_SYNC_TOKEN=
# Exact public HTTPS origin, no trailing slash. Never use * or null.
ARKIVE_ALLOWED_ORIGINS=https://brain.example.com
# Optional chat adapter. The base ends at /v1, NOT /chat/completions.
ARKIVE_MODEL_BASE_URL=
ARKIVE_MODEL=
ARKIVE_MODEL_API_KEY=
# Deliberately omit ARKIVE_BRAIN_PASSPHRASE: unlock manually after restart.
